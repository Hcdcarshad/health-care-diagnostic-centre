<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Health Care Diagnostic — Book a Test</title>
<meta name="description" content="NABL-standard diagnostic testing in Dabeerpura, Hyderabad. Blood, thyroid, anemia & allergy testing with home sample collection." />
<meta name="color-scheme" content="light" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{
    color-scheme: light;
    --ink:#0F1E2B;
    --pine:#0B5E71;
    --pine-deep:#083F4C;
    --mint:#8FDCD4;
    --mint-pale:#E6F7F5;
    --paper:#F3F9F8;
    --coral:#E14953;
    --coral-deep:#C93540;
    --line:rgba(15,30,43,0.12);
    --shadow: 0 20px 50px -20px rgba(8,63,76,0.35);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Manrope',sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:600;
    letter-spacing:-0.01em;
    margin:0;
  }
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  section{position:relative;}
  .wrap{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
  }
  ::selection{background:var(--coral);color:#fff;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  /* ---------- reveal on scroll ---------- */
  .reveal{
    opacity:0;
    transform:translateY(28px);
    transition:opacity 0.8s cubic-bezier(.22,1,.36,1), transform 0.8s cubic-bezier(.22,1,.36,1);
  }
  .reveal.in{opacity:1; transform:translateY(0);}
  .reveal-delay-1.in{transition-delay:0.1s;}
  .reveal-delay-2.in{transition-delay:0.2s;}
  .reveal-delay-3.in{transition-delay:0.3s;}

  /* ---------- nav ---------- */
  .nav{
    position:fixed;
    top:0; left:0; right:0;
    z-index:100;
    padding:26px 0;
    transition:padding 0.4s cubic-bezier(.22,1,.36,1), background 0.4s ease, box-shadow 0.4s ease, backdrop-filter 0.4s ease;
  }
  .nav.scrolled{
    padding:12px 0;
    background:rgba(243,249,248,0.72);
    backdrop-filter:blur(8px) saturate(140%);
    -webkit-backdrop-filter:blur(8px) saturate(140%);
    box-shadow:0 8px 30px -18px rgba(8,63,76,0.35);
  }
  .nav-inner{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:'Fraunces', serif;
    font-weight:700;
    font-style:italic;
    font-size:19px;
    color:#D6262E;
  }
  .logo svg{width:26px;height:26px;transition:transform 0.4s ease;}
  .nav.scrolled .logo svg{transform:scale(0.9);}
  .nav-links{
    display:flex;
    gap:34px;
    list-style:none;
    margin:0; padding:0;
    font-size:15px;
    font-weight:600;
  }
  .nav-links a{
    position:relative;
    color:var(--pine-deep);
    padding:4px 0;
  }
  .nav-links a::after{
    content:'';
    position:absolute;
    left:0; bottom:-2px;
    width:0%; height:2px;
    background:var(--coral);
    border-radius:2px;
    transition:width 0.3s cubic-bezier(.22,1,.36,1);
  }
  .nav-links a:hover::after{width:100%;}
  .nav-cta{
    background:var(--pine-deep) !important;
    color:#ffffff !important;
    padding:10px 20px;
    border-radius:999px;
    font-weight:700;
    font-size:14px;
    box-shadow:0 8px 20px -8px rgba(8,63,76,0.6);
    transition:transform 0.25s ease, background 0.25s ease;
    -webkit-text-fill-color:#ffffff;
  }
  .nav-cta:hover{background:var(--coral-deep); transform:translateY(-2px);}

  /* ---------- mobile nav toggle ---------- */
  .nav-toggle{
    display:none;
    align-items:center;
    justify-content:center;
    width:40px; height:40px;
    border:none;
    background:transparent;
    color:var(--pine-deep);
    cursor:pointer;
    padding:0;
    flex-shrink:0;
  }
  .nav-toggle svg{width:24px;height:24px;}
  .nav-toggle .icon-close{display:none;}
  .nav-toggle[aria-expanded="true"] .icon-menu{display:none;}
  .nav-toggle[aria-expanded="true"] .icon-close{display:block;}

  .nav-mobile-panel{
    display:none;
    position:fixed;
    top:0; left:0; right:0;
    z-index:99;
    background:var(--paper);
    box-shadow:0 20px 40px -20px rgba(8,63,76,0.4);
    border-bottom:1px solid var(--line);
    padding:88px 32px 28px;
    transform:translateY(-12px);
    opacity:0;
    pointer-events:none;
    transition:opacity 0.3s ease, transform 0.3s ease;
  }
  .nav-mobile-panel.open{
    display:block;
    opacity:1;
    transform:translateY(0);
    pointer-events:auto;
  }
  .nav-mobile-panel ul{
    list-style:none;
    margin:0; padding:0;
    display:flex;
    flex-direction:column;
    gap:4px;
  }
  .nav-mobile-panel a{
    display:block;
    padding:14px 4px;
    font-size:17px;
    font-weight:600;
    color:var(--pine-deep);
    border-bottom:1px solid var(--line);
  }
  .nav-mobile-panel .nav-cta{
    display:inline-flex;
    margin-top:20px;
  }

  /* ---------- hero ---------- */
  .hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:150px 0 90px;
    background:
      radial-gradient(circle at 82% 18%, rgba(143,220,212,0.55), transparent 55%),
      radial-gradient(circle at 10% 85%, rgba(225,73,83,0.14), transparent 45%),
      var(--paper);
    position:relative;
    overflow:hidden;
  }
  .hero-grid{
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:60px;
    align-items:center;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:13px;
    font-weight:700;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--pine);
    background:var(--mint-pale);
    padding:8px 14px;
    border-radius:999px;
    margin-bottom:24px;
  }
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--coral);animation:pulse 2.2s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:1; transform:scale(1);} 50%{opacity:0.4; transform:scale(0.7);}}

  .hero h1{
    font-size:clamp(40px, 5.4vw, 74px);
    line-height:1.02;
    color:var(--pine-deep);
  }
  .hero h1 em{
    font-style:italic;
    color:var(--coral);
    position:relative;
    white-space:nowrap;
  }
  .hero-sub{
    margin-top:24px;
    font-size:18px;
    line-height:1.6;
    color:rgba(15,30,43,0.72);
    max-width:460px;
  }
  .hero-actions{
    margin-top:38px;
    display:flex;
    gap:16px;
    flex-wrap:wrap;
    align-items:center;
  }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:16px 28px;
    border-radius:999px;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    border:none;
    transition:transform 0.2s cubic-bezier(.34,1.56,.64,1), box-shadow 0.3s ease, background 0.3s ease;
  }
  .btn-primary{
    background:var(--coral);
    color:#fff;
    box-shadow:0 14px 30px -12px rgba(201,53,64,0.65);
    animation:bounceIn 1s cubic-bezier(.34,1.56,.64,1) 0.3s both;
  }
  .btn-primary:hover{
    transform:translateY(-4px) scale(1.03);
    background:var(--coral-deep);
    box-shadow:0 18px 36px -12px rgba(201,53,64,0.75);
  }
  .btn-primary:active{transform:translateY(-1px) scale(0.98);}
  @keyframes bounceIn{
    0%{transform:scale(0.6); opacity:0;}
    60%{transform:scale(1.06); opacity:1;}
    80%{transform:scale(0.96);}
    100%{transform:scale(1);}
  }
  .btn-ghost{
    background:transparent;
    color:var(--pine-deep);
    border:1.5px solid var(--line);
  }
  .btn-ghost:hover{border-color:var(--pine-deep); transform:translateY(-2px);}

  .hero-stats{
    margin-top:46px;
    display:flex;
    gap:36px;
  }
  .hero-stats div strong{
    display:block;
    font-family:'Fraunces',serif;
    font-size:28px;
    color:var(--pine-deep);
  }
  .hero-stats div span{
    font-size:13px;
    color:rgba(15,30,43,0.6);
  }

  /* hero visual: orbit rings + vial */
  .hero-visual{
    position:relative;
    height:520px;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .orbit-ring{
    position:absolute;
    border-radius:50%;
    border:1.5px dashed rgba(11,94,113,0.22);
  }
  .orbit-ring.r1{width:420px;height:420px;animation:spin 40s linear infinite;}
  .orbit-ring.r2{width:330px;height:330px;animation:spin 30s linear infinite reverse;}
  @keyframes spin{from{transform:rotate(0deg);} to{transform:rotate(360deg);}}

  .tooth-card{
    position:relative;
    width:280px;
    height:340px;
    background:linear-gradient(155deg,#ffffff, var(--mint-pale));
    border-radius:36px;
    box-shadow:var(--shadow);
    display:flex;
    align-items:center;
    justify-content:center;
    animation:float 5s ease-in-out infinite;
  }
  @keyframes float{0%,100%{transform:translateY(0px) rotate(-1deg);} 50%{transform:translateY(-16px) rotate(1deg);}}
  .tooth-card svg{width:150px;height:150px;}
  .tooth-card .brand-mark{width:190px; height:auto; object-fit:contain;}

  .sparkle{
    position:absolute;
    width:10px;height:10px;
    background:var(--coral);
    border-radius:50%;
    opacity:0.8;
    animation:sparkle 2.4s ease-in-out infinite;
  }
  .sparkle:nth-child(1){top:16%; left:20%; animation-delay:0s;}
  .sparkle:nth-child(2){top:70%; left:14%; animation-delay:0.6s; background:var(--mint);}
  .sparkle:nth-child(3){top:22%; left:80%; animation-delay:1.1s; background:var(--mint);}
  .sparkle:nth-child(4){top:78%; left:76%; animation-delay:1.7s;}
  @keyframes sparkle{
    0%,100%{opacity:0; transform:scale(0.4) translateY(0);}
    50%{opacity:1; transform:scale(1) translateY(-10px);}
  }

  /* ---------- section headers ---------- */
  .section-head{
    max-width:560px;
    margin-bottom:56px;
  }
  .section-head .eyebrow{margin-bottom:18px;}
  .section-head h2{
    font-size:clamp(32px,3.6vw,46px);
    color:var(--pine-deep);
    line-height:1.08;
  }
  .section-head p{
    margin-top:16px;
    font-size:17px;
    color:rgba(15,30,43,0.68);
    line-height:1.6;
  }
  .center{margin-left:auto; margin-right:auto; text-align:center;}

  /* divider */
  .drip-divider{
    display:block;
    width:100%;
    height:46px;
  }
  .drip-divider path{ transition: d 0.3s ease; }

  /* ---------- services ---------- */
  .services{
    padding:120px 0 100px;
    background:var(--paper);
  }
  .service-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:26px;
    perspective:1400px;
  }
  .service-card{
    height:330px;
    background:transparent;
    cursor:pointer;
    outline:none;
  }
  .flip-inner{
    position:relative;
    width:100%;
    height:100%;
    transition:transform 0.7s cubic-bezier(.22,1,.36,1);
    transform-style:preserve-3d;
  }
  .service-card.flipped .flip-inner{transform:rotateY(180deg);}
  .service-card:focus-visible .flip-front{box-shadow:0 0 0 3px var(--coral), 0 18px 40px -28px rgba(8,63,76,0.4);}
  .flip-face{
    position:absolute;
    inset:0;
    border-radius:22px;
    backface-visibility:hidden;
    padding:28px;
    display:flex;
    flex-direction:column;
  }
  .flip-front{
    background:#fff;
    border:1px solid var(--line);
    justify-content:space-between;
    box-shadow:0 18px 40px -28px rgba(8,63,76,0.4);
  }
  .flip-front .icon-wrap{
    width:56px;height:56px;
    border-radius:16px;
    background:var(--mint-pale);
    display:flex; align-items:center; justify-content:center;
    color:var(--pine);
    transition:transform 0.4s ease, background 0.4s ease;
  }
  .service-card:hover .flip-front .icon-wrap{transform:rotate(-8deg) scale(1.08); background:var(--mint);}
  .flip-front h3{font-size:21px; color:var(--pine-deep); margin-top:18px; line-height:1.15;}
  .flip-front .tag{
    font-size:13px; font-weight:700; color:var(--coral);
    text-transform:uppercase; letter-spacing:0.06em;
  }
  .price-block{
    display:flex;
    align-items:baseline;
    gap:8px;
    margin-top:10px;
  }
  .price-block .mrp{
    font-size:14px;
    color:rgba(15,30,43,0.4);
    text-decoration:line-through;
  }
  .price-block .offer{
    font-family:'Fraunces',serif;
    font-size:22px;
    font-weight:600;
    color:var(--pine-deep);
  }
  .discount-tag{
    display:inline-block;
    margin-top:10px;
    font-size:12px;
    font-weight:800;
    letter-spacing:0.04em;
    color:var(--coral-deep);
    background:var(--coral-pale, rgba(201,53,64,0.1));
    padding:4px 10px;
    border-radius:999px;
    width:fit-content;
  }
  .flip-front .tap-hint{
    font-size:12.5px;
    font-weight:600;
    color:rgba(15,30,43,0.4);
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .badge-best{
    position:absolute;
    top:16px; right:16px;
    background:var(--coral);
    color:#fff;
    font-size:10px;
    font-weight:800;
    letter-spacing:0.05em;
    text-transform:uppercase;
    padding:5px 10px;
    border-radius:999px;
    box-shadow:0 6px 14px -6px rgba(201,53,64,0.6);
  }
  .flip-back{
    background:linear-gradient(155deg, var(--pine-deep), var(--pine));
    color:#fff;
    transform:rotateY(180deg);
    justify-content:space-between;
  }
  .flip-back h4{font-size:18px; color:#fff; font-family:'Fraunces',serif; font-weight:600; margin-bottom:12px;}
  .tests-included{flex:1; min-height:0; overflow-y:auto; margin:0 -4px 14px; padding:0 4px;}
  .tests-included::-webkit-scrollbar{width:5px;}
  .tests-included::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.25); border-radius:10px;}
  .tests-count{font-size:11.5px; font-weight:700; color:var(--mint); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:10px;}
  .test-list{list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:6px 8px;}
  .test-list li{background:rgba(255,255,255,0.14); padding:5px 10px; border-radius:999px; font-size:12px; color:#fff; line-height:1.3;}
  .flip-back .book-link{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:14px;
    font-weight:700;
    color:#fff;
    background:var(--coral);
    padding:10px 16px;
    border-radius:999px;
    width:fit-content;
    flex-shrink:0;
    transition:background 0.25s ease, transform 0.25s ease;
  }
  .flip-back .book-link:hover{background:var(--coral-deep); transform:translateX(3px);}

  /* ---------- about ---------- */
  .about{
    padding:110px 0;
    background:var(--mint-pale);
    overflow:hidden;
  }
  .about-grid{
    display:grid;
    grid-template-columns:0.9fr 1.1fr;
    gap:70px;
    align-items:center;
  }
  .about-visual{
    position:relative;
    height:440px;
  }
  .stack-layer{
    position:absolute;
    left:50%;
    border-radius:28px;
    box-shadow:0 24px 40px -22px rgba(8,63,76,0.35);
  }
  .stack-layer.l1{
    width:320px; height:190px; top:10%;
    transform:translateX(-50%);
    background:linear-gradient(155deg,#fff,#e2f5f2);
    border:1px solid var(--line);
    z-index:3;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .stack-layer.l1 svg{width:64px; height:64px; opacity:0.5;}
  .stack-layer.l2{
    width:340px; height:190px; top:32%;
    transform:translateX(-50%);
    background:var(--mint);
    z-index:2;
    opacity:0.9;
  }
  .stack-layer.l3{
    width:360px; height:190px; top:54%;
    transform:translateX(-50%);
    background:var(--pine);
    z-index:1;
    opacity:0.85;
  }
  .about-badge{
    position:absolute;
    bottom:6%; right:2%;
    background:#fff;
    border-radius:20px;
    padding:16px 20px;
    box-shadow:var(--shadow);
    display:flex; align-items:center; gap:12px;
    z-index:4;
  }
  .about-badge strong{font-family:'Fraunces',serif; font-size:24px; color:var(--pine-deep); display:block;}
  .about-badge span{font-size:12px; color:rgba(15,30,43,0.6);}

  .about-copy h2{
    font-size:clamp(30px,3.4vw,42px);
    color:var(--pine-deep);
    line-height:1.1;
  }
  .about-copy p{
    margin-top:20px;
    font-size:17px;
    line-height:1.7;
    color:rgba(15,30,43,0.72);
    max-width:480px;
  }
  .about-list{
    margin-top:28px;
    display:flex;
    flex-direction:column;
    gap:14px;
  }
  .about-list li{
    list-style:none;
    display:flex;
    align-items:center;
    gap:12px;
    font-weight:600;
    color:var(--pine-deep);
    font-size:15px;
  }
  .about-list svg{flex-shrink:0; color:var(--coral);}

  /* ---------- departments (static list, no flip/hover animation) ---------- */
  .departments{
    padding:90px 0;
    background:var(--mint-pale);
  }
  .dept-list{
    margin:0 auto;
    padding:0;
    list-style:none;
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:14px;
    max-width:920px;
  }
  .dept-list li{
    display:flex;
    align-items:center;
    gap:10px;
    background:#fff;
    border:1px solid var(--line);
    padding:14px 20px;
    border-radius:14px;
    font-weight:700;
    font-size:15px;
    color:var(--pine-deep);
  }
  .dept-list li svg{flex-shrink:0; color:var(--pine);}
  .extra-services{
    margin:56px auto 0;
    max-width:720px;
    background:linear-gradient(155deg, var(--pine-deep), var(--pine));
    border-radius:22px;
    padding:36px 40px;
    text-align:center;
  }
  .extra-services h3{
    color:#fff;
    font-family:'Fraunces',serif;
    font-size:22px;
    font-weight:600;
    margin-bottom:22px;
  }
  .extra-services-grid{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:16px;
  }
  .extra-service-item{
    display:flex;
    align-items:center;
    gap:10px;
    background:rgba(255,255,255,0.12);
    border:1px solid rgba(255,255,255,0.18);
    padding:14px 24px;
    border-radius:999px;
    color:#fff;
    font-weight:700;
    font-size:15px;
  }
  .extra-service-item svg{flex-shrink:0; color:var(--mint);}
  @media (max-width: 560px){
    .dept-list li{font-size:14px; padding:12px 16px;}
    .extra-services{padding:30px 24px;}
    .extra-service-item{width:100%; justify-content:center;}
  }

  /* ---------- testimonials ---------- */
  .testimonials{
    padding:110px 0;
    background:var(--pine-deep);
    color:#fff;
    overflow:hidden;
  }
  .testimonials .section-head h2{color:#fff;}
  .testimonials .section-head p{color:rgba(255,255,255,0.65);}
  .testimonials .eyebrow{background:rgba(143,220,212,0.16); color:var(--mint);}

  .t-track-wrap{
    overflow-x:auto;
    overflow-y:hidden;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    -ms-overflow-style:none;
    -webkit-mask-image:linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image:linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    padding:4px 0 20px;
  }
  .t-track-wrap::-webkit-scrollbar{display:none;}
  .t-track{
    display:flex;
    gap:24px;
    width:max-content;
  }
  .t-card{
    width:340px;
    flex-shrink:0;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:22px;
    padding:28px;
  }
  .t-stars{color:var(--coral); font-size:15px; letter-spacing:2px; margin-bottom:14px;}
  .t-card p{font-size:15px; line-height:1.65; color:rgba(255,255,255,0.85);}
  .t-person{display:flex; align-items:center; gap:12px; margin-top:20px;}
  .t-avatar{
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg, var(--mint), var(--coral));
    display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces',serif; font-weight:600; color:var(--pine-deep); font-size:15px;
  }
  .t-person strong{display:block; font-size:14px;}
  .t-person span{font-size:12px; color:rgba(255,255,255,0.55);}

  /* ---------- booking / contact ---------- */
  .booking{
    padding:120px 0;
    background:var(--paper);
  }
  .booking-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
  }
  .contact-cards{display:flex; flex-direction:column; gap:16px; margin-top:8px;}
  .contact-card{
    display:flex;
    align-items:center;
    gap:16px;
    background:#fff;
    border:1px solid var(--line);
    border-radius:18px;
    padding:20px 22px;
    transition:transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .contact-card:hover{transform:translateY(-3px); box-shadow:0 16px 34px -22px rgba(8,63,76,0.4); border-color:var(--mint);}
  .contact-card .cc-icon{
    width:48px; height:48px; border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .cc-icon.whatsapp{background:#25D366; color:#fff;}
  .cc-icon.phone{background:var(--pine-deep); color:#fff;}
  .cc-icon.location{background:var(--coral); color:#fff;}
  .cc-icon.prescription{background:var(--mint); color:var(--pine-deep);}
  .prescription-note{
    display:none; align-items:flex-start; gap:10px;
    margin-top:10px; padding:12px 14px; border-radius:14px;
    background:var(--mint-pale); color:var(--pine-deep); font-size:13.5px; line-height:1.45;
  }
  .prescription-note.show{display:flex;}
  .prescription-note strong{display:block; margin-bottom:2px;}
  .prescription-thumb{width:38px; height:38px; border-radius:8px; object-fit:cover; flex-shrink:0; border:1px solid rgba(8,63,76,0.15);}
  .contact-card strong{display:block; font-size:16px; color:var(--pine-deep);}
  .contact-card span{font-size:14px; color:rgba(15,30,43,0.6);}
  .contact-card .go{margin-left:auto; color:var(--pine-deep); opacity:0.4; transition:transform 0.25s ease, opacity 0.25s ease;}
  .contact-card:hover .go{transform:translateX(4px); opacity:1;}

  .social-row{
    margin-top:28px;
    display:flex;
    gap:12px;
  }
  .social-row a{
    width:42px; height:42px;
    border-radius:50%;
    border:1.5px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    color:var(--pine-deep);
    transition:transform 0.25s cubic-bezier(.34,1.56,.64,1), background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .social-row a:hover{background:var(--coral); border-color:var(--coral); color:#fff; transform:translateY(-4px) rotate(-6deg);}

  .booking-form{
    background:#fff;
    border-radius:26px;
    border:1px solid var(--line);
    padding:38px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
  }
  .booking-form h3{font-size:22px; color:var(--pine-deep); margin-bottom:6px;}
  .booking-form > p{font-size:14px; color:rgba(15,30,43,0.6); margin-bottom:26px;}
  .field{
    position:relative;
    margin-bottom:24px;
  }
  .field input, .field textarea, .field select{
    width:100%;
    border:none;
    border-bottom:2px solid var(--line);
    background:transparent;
    padding:14px 4px 10px;
    font-family:'Manrope',sans-serif;
    font-size:15px;
    color:var(--ink);
    outline:none;
    transition:border-color 0.25s ease;
    resize:none;
  }
  .field select{appearance:none;}
  .field input:focus, .field textarea:focus, .field select:focus{border-color:var(--coral);}
  .field label{
    position:absolute;
    left:4px; top:14px;
    font-size:15px;
    color:rgba(15,30,43,0.45);
    pointer-events:none;
    transition:transform 0.22s cubic-bezier(.22,1,.36,1), color 0.22s ease, font-size 0.22s ease;
    transform-origin:left top;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label,
  .field select:focus + label,
  .field.filled label{
    transform:translateY(-20px);
    font-size:12px;
    color:var(--coral);
    font-weight:700;
  }
  .field-row{display:grid; grid-template-columns:1fr 1fr; gap:20px;}
  .slot-note{
    font-size:12.5px;
    line-height:1.5;
    color:rgba(15,30,43,0.55);
    margin:-10px 0 22px;
  }
  .submit-btn{
    width:100%;
    justify-content:center;
    margin-top:6px;
  }
  .form-success{
    position:absolute;
    inset:0;
    background:#fff;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px;
    opacity:0;
    pointer-events:none;
    transform:scale(0.96);
    transition:opacity 0.4s ease, transform 0.4s ease;
  }
  .form-success.show{opacity:1; pointer-events:all; transform:scale(1);}
  .check-circle{
    width:76px; height:76px;
    border-radius:50%;
    background:var(--mint-pale);
    display:flex; align-items:center; justify-content:center;
    margin-bottom:20px;
    animation:pop 0.5s cubic-bezier(.34,1.56,.64,1) 0.1s both;
  }
  @keyframes pop{from{transform:scale(0);} to{transform:scale(1);}}
  .form-success h4{font-size:22px; color:var(--pine-deep);}
  .form-success p{margin-top:10px; font-size:14px; color:rgba(15,30,43,0.6); max-width:280px;}
  .confetti-piece{
    position:absolute;
    top:-10px;
    width:8px; height:14px;
    opacity:0.9;
    animation:confetti-fall 1.6s ease-in forwards;
  }
  @keyframes confetti-fall{
    to{ transform: translateY(340px) rotate(540deg); opacity:0; }
  }

  /* ---------- map ---------- */
  .map-section{padding:0 0 110px; background:var(--paper);}
  .map-frame{
    border-radius:26px;
    overflow:hidden;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    height:420px;
    position:relative;
  }
  .map-frame iframe{width:100%; height:100%; border:0; filter:grayscale(8%) contrast(1.02);}
  .map-pin-card{
    position:absolute;
    left:24px; bottom:24px;
    background:#fff;
    border-radius:16px;
    padding:16px 20px;
    box-shadow:var(--shadow);
    max-width:260px;
  }
  .map-pin-card strong{display:block; font-size:15px; color:var(--pine-deep); margin-bottom:4px;}
  .map-pin-card span{font-size:13px; color:rgba(15,30,43,0.6); line-height:1.5;}

  /* ---------- footer ---------- */
  .footer{
    background:var(--pine-deep);
    color:rgba(255,255,255,0.75);
    padding:60px 0 30px;
  }
  .syrup-divider{display:block; width:100%; margin-top:-1px;}
  .footer-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr;
    gap:40px;
    padding-top:20px;
  }
  .footer-logo{
    display:flex; align-items:center; gap:10px;
    font-family:'Fraunces',serif; font-size:20px; font-weight:700; font-style:italic; color:#D6262E;
    margin-bottom:14px;
  }
  .footer p.desc{font-size:14px; line-height:1.6; max-width:280px;}
  .footer h5{font-size:13px; text-transform:uppercase; letter-spacing:0.08em; color:rgba(255,255,255,0.5); margin-bottom:16px;}
  .footer-links{list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:10px; font-size:14px;}
  .footer-links a{transition:color 0.2s ease, padding-left 0.2s ease;}
  .footer-links a:hover{color:var(--mint); padding-left:4px;}
  .footer-bottom{
    margin-top:46px;
    padding-top:24px;
    border-top:1px solid rgba(255,255,255,0.12);
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:12px;
    font-size:13px;
    color:rgba(255,255,255,0.45);
  }

  /* responsive */
  @media (max-width: 900px){
    .hero-grid, .about-grid, .booking-grid{grid-template-columns:1fr;}
    .hero-visual{height:360px; order:-1;}
    .service-grid{grid-template-columns:repeat(2,1fr);}
    .about-visual{height:320px;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .nav-links{display:none;}
    .nav-toggle{display:flex;}
  }
  @media (min-width: 901px){
    .nav-mobile-panel{display:none !important;}
    .nav-links{margin-right:48px;}
  }
  @media (max-width: 560px){
    .wrap{padding:0 20px;}
    .service-grid{grid-template-columns:1fr;}
    .field-row{grid-template-columns:1fr;}
    .hero-stats{gap:22px;}
    .footer-grid{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

<!-- ================= NAV ================= -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="#home" class="logo">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3c4.5 5 8 9.5 8 13.5A8 8 0 014 16.5C4 12.5 7.5 8 12 3z" fill="#D6262E"/></svg>
      Health Care Diagnostic
    </a>
    <ul class="nav-links">
      <li><a href="#home">Home</a></li>
      <li><a href="#services">Packages</a></li>
      <li><a href="#departments">Departments</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#stories">Reviews</a></li>
      <li><a href="#book">Contact</a></li>
    </ul>
    <a class="nav-cta" href="#book">Book a Test</a>
    <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navMobilePanel" aria-label="Open menu">
      <svg class="icon-menu" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="nav-mobile-panel" id="navMobilePanel">
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#services">Packages</a></li>
      <li><a href="#departments">Departments</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#stories">Reviews</a></li>
      <li><a href="#book">Contact</a></li>
    </ul>
    <a class="nav-cta" href="#book">Book a Test</a>
  </div>
</nav>

<!-- ================= HERO ================= -->
<section class="hero" id="home">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow"><span class="dot"></span> Home sample collection available</div>
      <h1>Health answers, delivered with <em>accuracy</em>.</h1>
      <p class="hero-sub">Trusted diagnostic testing in the heart of Dabeerpura, Hyderabad — from routine blood work to specialised panels, with home collection and reports you can rely on.</p>
      <div class="hero-actions">
        <a href="#book" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 8v8M8 12h8" stroke="white" stroke-width="2.4" stroke-linecap="round"/></svg>
          Book a Test
        </a>
        <a href="#services" class="btn btn-ghost">See packages</a>
      </div>
      <div class="hero-stats">
        <div><strong>4.8★</strong><span>Patient rating</span></div>
        <div><strong>25k+</strong><span>Tests conducted</span></div>
        <div><strong>24 hrs</strong><span>Report turnaround</span></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="orbit-ring r1"></div>
      <div class="orbit-ring r2"></div>
      <div class="tooth-card">
        <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle"></span><span class="sparkle"></span>
        <img src="data:image/png;base64," alt="Health Care Diagnostic — Accurate, Economical" class="brand-mark" />
      </div>
    </div>
  </div>
</section>

<!-- divider -->
<svg class="drip-divider" viewBox="0 0 1200 46" preserveAspectRatio="none"><path d="M0 0 H1200 V16 C1100 34 1000 8 900 22 C800 36 700 10 600 24 C500 38 400 8 300 20 C200 32 100 10 0 20 Z" fill="var(--mint-pale)"/></svg>

<!-- ================= SERVICES ================= -->
<section class="services" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Our Packages</div>
      <h2>Diagnostic packages for every health check</h2>
      <p>Tap a card to see everything included — book straight to WhatsApp when you're ready.</p>
    </div>
    <div class="service-grid" id="serviceGrid">
      <!-- cards are generated by PROFILE_DATA in the script below -->
    </div>
  </div>
</section>

<!-- ================= DEPARTMENTS (plain list, no card animation) ================= -->
<section class="departments" id="departments">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">What We Cover</div>
      <h2>Departments at our centre</h2>
      <p>Every sample is processed in-house across these specialised departments.</p>
    </div>
    <ul class="dept-list reveal reveal-delay-1">
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Allergy</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Clinical Biochemistry</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Clinical Pathology</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Haematology</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Histopathology</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Immunology &amp; Serology</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Immunogenetics (HLA Typing)</li>
      <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Microbiology</li>
    </ul>

    <div class="extra-services reveal reveal-delay-2">
      <h3>We also offer</h3>
      <div class="extra-services-grid">
        <div class="extra-service-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="2.2" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="6" r="2.2" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="18" r="2.2" stroke="currentColor" stroke-width="1.7"/><path d="M8 7l3 9M16 7l-3 9M8.5 6h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Networking Clients</span>
        </div>
        <div class="extra-service-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3h6M10 3v6l-5 9a2 2 0 001.8 3h10.4a2 2 0 001.8-3l-5-9V3" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span>Lab In Lab</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= ABOUT ================= -->
<section class="about" id="about">
  <div class="wrap about-grid">
    <div class="about-visual reveal">
      <div class="stack-layer l3"></div>
      <div class="stack-layer l2"></div>
      <div class="stack-layer l1" style="display:flex;align-items:center;justify-content:center;overflow:hidden;">
        <img src="data:image/png;base64," alt="Health Care Diagnostic logo" style="width:70%;height:70%;object-fit:contain;" />
      </div>
      <div class="about-badge">
        <strong>11+</strong>
        <span>years serving<br/>this neighborhood</span>
      </div>
    </div>
    <div class="about-copy reveal reveal-delay-1">
      <div class="eyebrow">About us</div>
      <h2>Reports you can trust, explained in plain language.</h2>
      <p>Health Care Diagnostic runs on one simple rule: every report comes with a clear explanation, not just numbers on a page. That rule guides every test we run today, from a quick blood draw to specialised hormone panels.</p>
      <ul class="about-list">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Accredited lab, tested for accuracy</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Home sample collection across the city</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Digital reports within 24 hours</li>
      </ul>
    </div>
  </div>
</section>

<!-- ================= TESTIMONIALS ================= -->
<section class="testimonials" id="stories">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Patient Reviews</div>
      <h2>What our patients say</h2>
      <p style="color:rgba(255,255,255,0.5); font-size:13px; margin-top:6px;">Swipe to see more →</p>
    </div>
  </div>
  <div class="t-track-wrap">
    <div class="t-track" id="tTrack">
      <!-- set A -->
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"The home collection was so convenient — the phlebotomist arrived on time and my report came the next morning."</p><div class="t-person"><div class="t-avatar">P</div><div><strong>Priya K.</strong><span>Home collection</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Got my thyroid panel done here. Results were clear and the staff explained everything patiently."</p><div class="t-person"><div class="t-avatar">F</div><div><strong>Farhan S.</strong><span>Thyroid testing</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Quick blood test, no long wait, and booking on WhatsApp made the whole thing effortless."</p><div class="t-person"><div class="t-avatar">A</div><div><strong>Ayesha R.</strong><span>Blood testing</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Finally found accurate allergy testing nearby — professional, affordable, and easy to book."</p><div class="t-person"><div class="t-avatar">R</div><div><strong>Rajesh M.</strong><span>Allergy testing</span></div></div></div>
      <!-- set B (duplicate for seamless loop) -->
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"The home collection was so convenient — the phlebotomist arrived on time and my report came the next morning."</p><div class="t-person"><div class="t-avatar">P</div><div><strong>Priya K.</strong><span>Home collection</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Got my thyroid panel done here. Results were clear and the staff explained everything patiently."</p><div class="t-person"><div class="t-avatar">F</div><div><strong>Farhan S.</strong><span>Thyroid testing</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Quick blood test, no long wait, and booking on WhatsApp made the whole thing effortless."</p><div class="t-person"><div class="t-avatar">A</div><div><strong>Ayesha R.</strong><span>Blood testing</span></div></div></div>
      <div class="t-card"><div class="t-stars">★★★★★</div><p>"Finally found accurate allergy testing nearby — professional, affordable, and easy to book."</p><div class="t-person"><div class="t-avatar">R</div><div><strong>Rajesh M.</strong><span>Allergy testing</span></div></div></div>
    </div>
  </div>
</section>

<!-- ================= BOOKING / CONTACT ================= -->
<section class="booking" id="book">
  <div class="wrap booking-grid">
    <div class="reveal">
      <div class="eyebrow">Get in touch</div>
      <h2 style="font-size:clamp(30px,3.4vw,42px); color:var(--pine-deep); line-height:1.1;">Book in under a minute</h2>
      <p style="margin-top:16px; font-size:16px; color:rgba(15,30,43,0.68); max-width:420px;">Message us on WhatsApp, call the front desk, or send the form — whichever's easiest.</p>

      <div class="contact-cards">
        <a class="contact-card" href="https://wa.me/919703119191?text=Hi%20Health%20Care%20Diagnostic%20Centre%2C%20I%27d%20like%20to%20book%20a%20test." target="_blank" rel="noopener">
          <div class="cc-icon whatsapp"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.7 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.6-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5.2.5.8 1.9.8 2 .1.2.1.4 0 .6-.1.2-.2.3-.3.5-.2.2-.3.3-.5.5-.2.2-.4.4-.2.7.2.3.9 1.5 2 2.4 1.3 1.2 2.5 1.5 2.8 1.7.3.2.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.7.8 2 1 .3.1.5.2.6.3.1.2.1.9-.1 1.6z"/></svg></div>
          <div><strong>Message on WhatsApp</strong><span>Usually replies in minutes</span></div>
          <svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
        </a>
        <button type="button" class="contact-card" id="prescriptionCard" style="cursor:pointer; text-align:left; font:inherit; width:100%;">
          <div class="cc-icon prescription"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 4v11M12 15l-4-4M12 15l4-4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 16v2a2 2 0 002 2h10a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></div>
          <div><strong>Upload your prescription</strong><span>Not sure which test? Just send us a photo</span></div>
          <svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
        </button>
        <input type="file" id="prescriptionInput" accept="image/*,.pdf" capture="environment" style="display:none;" />
        <a class="contact-card" href="tel:+919703119191">
          <div class="cc-icon phone"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 2 .6 3a2 2 0 01-.5 2.1L8 10a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c1 .3 2 .5 3 .6a2 2 0 011.7 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></div>
          <div><strong>Call the front desk</strong><span>+91 97031 19191</span></div>
          <svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
        </a>
        <a class="contact-card" href="https://maps.google.com/maps?cid=11171451577261019353" target="_blank" rel="noopener">
          <div class="cc-icon location"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 22s7-7.4 7-12.5A7 7 0 005 9.5C5 14.6 12 22 12 22z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.8"/></svg></div>
          <div><strong>Visit the centre</strong><span>22-2-10, Komatwadi, Dabeerpura North, Hyderabad 500024</span></div>
          <svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
        </a>
        <div class="contact-card" style="cursor:default;">
          <div class="cc-icon location"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></div>
          <div><strong>Centre hours</strong><span>Mon–Sat: 9:00 AM – 9:00 PM<br/>Sun: Closed</span></div>
        </div>
      </div>

      <div class="prescription-note" id="prescriptionNote">
        <img class="prescription-thumb" id="prescriptionThumb" alt="" />
        <div>
          <strong id="prescriptionNoteTitle">Opening WhatsApp…</strong>
          <span id="prescriptionNoteText">Attach the photo you just picked to the chat before sending — we'll take a look and tell you which tests you need.</span>
        </div>
      </div>

      <div class="social-row">
        <a href="#" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor"/></svg></a>
        <a href="#" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></a>
        <a href="#" aria-label="YouTube"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="6" width="19" height="12" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 9.5l5 2.5-5 2.5v-5z" fill="currentColor"/></svg></a>
      </div>
    </div>

    <div class="booking-form reveal reveal-delay-1">
      <h3>Request a test / home collection</h3>
      <p>We'll confirm your slot by WhatsApp or phone within one business day.</p>
      <form id="bookingForm" novalidate>
        <div class="field-row">
          <div class="field">
            <input type="text" id="fname" placeholder=" " required />
            <label for="fname">Full name</label>
          </div>
          <div class="field">
            <input type="tel" id="fphone" placeholder=" " required />
            <label for="fphone">Phone number</label>
          </div>
        </div>
        <div class="field">
          <select id="fservice" required>
            <option value="" disabled selected hidden></option>
          </select>
          <label for="fservice">Package needed</label>
        </div>
        <div class="field">
          <input type="date" id="fdate" placeholder=" " required />
          <label for="fdate">Preferred date</label>
        </div>
        <p class="slot-note">Choose your preferred day for home collection — we'll confirm the exact time by WhatsApp or phone once we see your booking.</p>
        <div class="field">
          <textarea id="fmsg" rows="3" placeholder=" "></textarea>
          <label for="fmsg">Anything we should know? (optional)</label>
