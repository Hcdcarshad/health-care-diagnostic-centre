<script>
  // ===== SERVICE PACKAGES (edit this list to add/remove/change packages) =====
  const PROFILE_DATA = [
    { name: 'Diabetic Profile', tests: ['CBP','LFT','Lipid Profile','Kidney Basic Screen','Thyroid Profile II','Iron Profile','HbA1c','Calcium','EgFr','Complete Urinary Examination'], bestseller: true, mrp: 3650, offer: 1500 },
    { name: 'Master Health Checkup Profile', tests: ['CBP','HbA1c','Lipid Profile','LFT','KFT','EgFr','Vitamin D','Vitamin B12','Iron Profile','Calcium','T3','T4','TSH','Complete Urinary Examination'], bestseller: true, mrp: 5500, offer: 2800 },
    { name: 'Complete Allergy Profile', tests: ['Veg','Non-Veg','Inhalant','Drugs','Total IgE'], bestseller: true, mrp: 8000, offer: 5000 },
    { name: 'Ultrasound Scan', tests: ['Ultrasound Scan'] },
    { name: 'Hair / Skin Profile', tests: ['CBP','Serum Calcium','Serum Ferritin','Thyroid Stimulating Hormone','Serum Iron','Vitamin B12','Vitamin D'] },
    { name: 'Liver Function Test', tests: ['Total Bilirubin','Direct Bilirubin','Indirect Bilirubin','SGOT','SGPT','Alkaline Phosphate','Total Protein','Albumin','Globin','A/G Ratio','GGT'] },
    { name: 'Antenatal Profile', tests: ['CBP','RBS','HIV','HbSAG','VDRL','HCV','Blood Grouping','TSH','CUE','BT','CT','Creatinine'] },
    { name: 'Lipid Profile', tests: ['Total Cholesterol','HDL Cholesterol','LDL Cholesterol','Triglycerides','VLDL'] },
    { name: 'Dialysis Profile', tests: ['Electrolytes','Protein Total','Alkaline Phosphate','Calcium','Phosphorous','Uric Acid','Creatinine','BUN'] },
    { name: 'Cardiac Profile', tests: ['Total Cholesterol','SGOT','SGPT','CPK','CBP','ESR','FBS'] },
    { name: 'Hypertension Profile', tests: ['CBP','ESR','CLE','Blood Urea','Serum Creatinine','Uric Acid','Lipid Profile'] },
    { name: 'Kidney Profile', tests: ['Urea','Creatinine','Sodium','Potassium','Chloride','BUN/Creatinine Ratio','Calcium','Uric Acid'] },
    { name: 'Fever Profile', tests: ['CBC','PF & PV','Widal','CUE','ESR','CRP'] },
    { name: 'Thyroid Profile', tests: ['T3','T4','TSH'] },
    { name: 'Dengue Profile', tests: ['Dengue NS1','IgG','IgM'] },
    { name: 'Infertility Profile', tests: ['LH','FSH','Prolactin','Testo','Total E2'] },
    { name: 'COVID', tests: ['RTPCR'] },
    { name: 'Pregnancy Profile', tests: ['CBP','Blood Grouping','HIV','HbSAG','VDRL','HCV','BT','CT','TSH','CUE','Creatinine','Complete Urinary Examination'] }
  ];

  // A small set of icons cycled across cards for visual variety
  const PROFILE_ICONS = [
    '<path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 8v5M12 16.5v.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
    '<path d="M12 3c4 5 7 9 7 12.5A7 7 0 015 15.5C5 12 8 8 12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 15h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
    '<path d="M9 3h6M10 3v13a2 2 0 004 0V3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 12.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    '<path d="M4 11l8-7 8 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9a1 1 0 001 1h10a1 1 0 001-1v-9" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 14v4M10 16h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    '<path d="M12 12c-2-4-8-5-8 0s6 6 8 2c2 4 8 3 8-2s-6-4-8 0z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>'
  ];

  function escapeHtml(str){
    return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function renderServiceCards(){
    const grid = document.getElementById('serviceGrid');
    if (!grid) return;
    const html = PROFILE_DATA.map((profile, i) => {
      const delay = (i % 3) + 1;
      const icon = PROFILE_ICONS[i % PROFILE_ICONS.length];
      const badge = profile.bestseller ? '<span class="badge-best">Bestseller</span>' : '';
      const chips = profile.tests.map(t => `<li>${escapeHtml(t)}</li>`).join('');
      const countLabel = `${profile.tests.length} test${profile.tests.length > 1 ? 's' : ''} included`;
      const priceBlock = profile.bestseller
        ? `<div class="price-block"><span class="mrp">₹${profile.mrp.toLocaleString('en-IN')}</span><span class="offer">₹${profile.offer.toLocaleString('en-IN')}</span></div>`
        : `<span class="discount-tag">20% OFF</span>`;
      const waPackageLink = `https://wa.me/919703119191?text=${encodeURIComponent(`Hi Health Care Diagnostic Centre, I'd like to book the ${profile.name} package.`)}`;
      return `
      <div class="service-card reveal reveal-delay-${delay}" tabindex="0" role="button" aria-pressed="false" aria-label="${escapeHtml(profile.name)}, tap to see included tests">
        <div class="flip-inner">
          <div class="flip-face flip-front">
            ${badge}
            <div class="icon-wrap"><svg width="26" height="26" viewBox="0 0 24 24" fill="none">${icon}</svg></div>
            <div><h3>${escapeHtml(profile.name)}</h3>${profile.bestseller ? '' : `<span class="tag">${countLabel}</span>`}${priceBlock}</div>
            <span class="tap-hint">Tap to view tests <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
          </div>
          <div class="flip-face flip-back">
            <div class="tests-included">
              ${profile.bestseller ? '' : `<span class="tests-count">${countLabel}</span>`}
              <ul class="test-list">${chips}</ul>
            </div>
            <a class="book-link" href="${waPackageLink}" target="_blank" rel="noopener">Book this package <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="white" stroke-width="2" stroke-linecap="round"/></svg></a>
          </div>
        </div>
      </div>`;
    }).join('');
    grid.innerHTML = html;

    // Click / keyboard flip
    grid.querySelectorAll('.service-card').forEach(card => {
      function toggleFlip(){
        const flipped = card.classList.toggle('flipped');
        card.setAttribute('aria-pressed', flipped ? 'true' : 'false');
      }
      card.addEventListener('click', toggleFlip);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleFlip(); }
      });
    });
    // Don't let the book link's click also toggle the flip
    grid.querySelectorAll('.book-link').forEach(link => {
      link.addEventListener('click', e => e.stopPropagation());
    });
  }
  renderServiceCards();

  // Keep the booking form's package dropdown in sync with the cards above
  (function populateServiceSelect(){
    const select = document.getElementById('fservice');
    if (!select) return;
    PROFILE_DATA.forEach(profile => {
      const opt = document.createElement('option');
      opt.textContent = profile.name;
      select.appendChild(opt);
    });
    const otherOpt = document.createElement('option');
    otherOpt.textContent = 'Other / Not sure';
    select.appendChild(otherOpt);
  })();

  // Sticky nav shrink + blur (throttled via rAF so it doesn't run on every scroll tick)
  const nav = document.getElementById('nav');
  let navTicking = false;
  window.addEventListener('scroll', () => {
    if (navTicking) return;
    navTicking = true;
    requestAnimationFrame(() => {
      nav.classList.toggle('scrolled', window.scrollY > 40);
      navTicking = false;
    });
  }, { passive: true });

  // Mobile nav toggle
  (function initMobileNav(){
    const toggle = document.getElementById('navToggle');
    const panel = document.getElementById('navMobilePanel');
    if (!toggle || !panel) return;

    function closeMenu(){
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      panel.classList.remove('open');
    }
    function openMenu(){
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      panel.classList.add('open');
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    // Close after tapping a link
    panel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close if the viewport grows past the mobile breakpoint
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) closeMenu();
    });
  })();

  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.15 });
  revealEls.forEach(el => io.observe(el));

  // Testimonials: auto-scroll animation that pauses for manual touch/drag
  (function initTestimonialAutoScroll(){
    const wrap = document.querySelector('.t-track-wrap');
    const track = document.getElementById('tTrack');
    if (!wrap || !track) return;

    const SPEED = 0.4; // px per frame, roughly 24px/sec
    let paused = false;
    let resumeTimer = null;
    let rafId = null;

    function halfWidth(){
      return track.scrollWidth / 2; // set A + set B are identical, so halfway = one full loop
    }

    function tick(){
      if (!paused){
        wrap.scrollLeft += SPEED;
        if (wrap.scrollLeft >= halfWidth()){
          wrap.scrollLeft -= halfWidth();
        }
      }
      rafId = requestAnimationFrame(tick);
    }

    function pause(){
      paused = true;
      clearTimeout(resumeTimer);
    }
    function scheduleResume(delay){
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { paused = false; }, delay);
    }

    // Pause while the user is actively touching/dragging, resume 1.5s after they let go
    ['pointerdown','touchstart','wheel'].forEach(evt =>
      wrap.addEventListener(evt, pause, { passive: true })
    );
    ['pointerup','touchend','touchcancel','pointercancel'].forEach(evt =>
      wrap.addEventListener(evt, () => scheduleResume(1500), { passive: true })
    );
    wrap.addEventListener('mouseenter', pause);
    wrap.addEventListener('mouseleave', () => scheduleResume(1500));

    // Only run the animation loop while this section is actually visible on screen —
    // no point burning CPU/battery scrolling a carousel nobody can see
    let visible = false;
    const visObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        visible = entry.isIntersecting;
        if (visible && rafId === null) {
          rafId = requestAnimationFrame(tick);
        } else if (!visible && rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      });
    }, { threshold: 0.01 });
    visObserver.observe(wrap);
  })();

  // Floating labels for select (needs a "filled" class helper since :not(:placeholder-shown) doesn't apply)
  const serviceSelect = document.getElementById('fservice');
  const serviceField = serviceSelect.closest('.field');
  serviceSelect.addEventListener('change', () => {
    serviceField.classList.toggle('filled', !!serviceSelect.value);
  });

  // Floating label for the date field (date inputs don't reliably support
  // :placeholder-shown across browsers, so we toggle a "filled" class manually)
  const dateInput = document.getElementById('fdate');
  const dateField = dateInput.closest('.field');

  // Minimum selectable date is tomorrow — customers can't book same-day.
  // Built from local date parts (not toISOString) so it's correct regardless of timezone.
  function formatLocalDate(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  dateInput.min = formatLocalDate(tomorrow);

  dateInput.addEventListener('input', () => {
    dateField.classList.toggle('filled', !!dateInput.value);
  });

  // Booking form submit -> build a WhatsApp message with the details, open WhatsApp, show success panel
  const form = document.getElementById('bookingForm');
  const successPanel = document.getElementById('formSuccess');
  const formWrap = document.querySelector('.booking-form');
  const CLINIC_WHATSAPP = '919703119191';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    const name = document.getElementById('fname').value.trim();
    const phone = document.getElementById('fphone').value.trim();
    const service = document.getElementById('fservice').value;
    const date = document.getElementById('fdate').value;
    const notes = document.getElementById('fmsg').value.trim();

    // Format date as DD/MM/YYYY for readability in the WhatsApp message
    const [y, m, d] = date.split('-');
    const formattedDate = `${d}/${m}/${y}`;

    let message = `Hi Health Care Diagnostic, I'd like to book a test.\n\n`;
    message += `Name: ${name}\n`;
    message += `Phone: ${phone}\n`;
    message += `Test needed: ${service}\n`;
    message += `Preferred date: ${formattedDate}`;
    if (notes) message += `\nNotes: ${notes}`;

    const waUrl = `https://wa.me/${CLINIC_WHATSAPP}?text=${encodeURIComponent(message)}`;

    launchConfetti(formWrap);
    successPanel.classList.add('show');

    // Give the confetti/success state a beat to register before handing off to WhatsApp
    setTimeout(() => {
      window.open(waUrl, '_blank', 'noopener');
    }, 600);

    setTimeout(() => {
      successPanel.classList.remove('show');
      form.reset();
      serviceField.classList.remove('filled');
      dateField.classList.remove('filled');
    }, 4200);
  });

  // Upload prescription -> share the photo straight to WhatsApp where supported,
  // otherwise open a pre-filled WhatsApp chat and prompt the person to attach it.
  (function initPrescriptionUpload(){
    const card = document.getElementById('prescriptionCard');
    const input = document.getElementById('prescriptionInput');
    const note = document.getElementById('prescriptionNote');
    const thumb = document.getElementById('prescriptionThumb');
    const noteTitle = document.getElementById('prescriptionNoteTitle');
    const noteText = document.getElementById('prescriptionNoteText');
    if (!card || !input) return;

    const waText = "Hi Health Care Diagnostic Centre, I've attached my prescription — could you tell me which test(s) I need?";
    const waUrl = `https://wa.me/${CLINIC_WHATSAPP}?text=${encodeURIComponent(waText)}`;

    card.addEventListener('click', () => input.click());

    input.addEventListener('change', async () => {
      const file = input.files && input.files[0];
      if (!file) return;

      // Show a small preview + status note (image files only get a thumbnail)
      if (file.type.startsWith('image/')) {
        thumb.src = URL.createObjectURL(file);
        thumb.style.display = 'block';
      } else {
        thumb.style.display = 'none';
      }
      note.classList.add('show');

      const canShareFile = !!(navigator.canShare && navigator.canShare({ files: [file] }));

      if (navigator.share && canShareFile) {
        // Best path on supported mobile browsers: native share sheet, pick WhatsApp,
        // photo + message go over together.
        try {
          noteTitle.textContent = 'Opening the share menu…';
          noteText.textContent = 'Choose WhatsApp from the list to send your prescription straight across.';
          await navigator.share({ files: [file], title: 'Prescription', text: waText });
          setTimeout(() => note.classList.remove('show'), 3000);
        } catch (err) {
          // Person cancelled the share sheet, or it failed — fall back below.
          if (err && err.name !== 'AbortError') {
            noteTitle.textContent = 'Opening WhatsApp…';
            noteText.textContent = "Attach the photo you just picked to the chat before sending — we'll take a look and tell you which tests you need.";
            window.open(waUrl, '_blank', 'noopener');
          } else {
            note.classList.remove('show');
          }
        }
      } else {
        // Fallback (mainly desktop browsers, which can't hand a file to WhatsApp):
        // open the chat with a ready message and tell the person to attach the photo themselves.
        noteTitle.textContent = 'Opening WhatsApp…';
        noteText.textContent = "Attach the photo you just picked to the chat before sending — we'll take a look and tell you which tests you need.";
        window.open(waUrl, '_blank', 'noopener');
        setTimeout(() => note.classList.remove('show'), 6000);
      }

      input.value = '';
    });
  })();

  function launchConfetti(container) {
    const colors = ['#E14953', '#8FDCD4', '#0B5E71', '#E6F7F5'];
    for (let i = 0; i < 26; i++) {
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.left = Math.random() * 100 + '%';
      piece.style.background = colors[Math.floor(Math.random() * colors.length)];
      piece.style.animationDelay = (Math.random() * 0.3) + 's';
      piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      container.appendChild(piece);
      setTimeout(() => piece.remove(), 2000);
    }
  }
</script>

</body>
</html>
